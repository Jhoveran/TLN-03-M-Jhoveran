interface Loopback0
 ip address 190.0.2.1 255.255.255.255
!
interface Ethernet0/1
 ip address 10.0.0.78 255.255.255.252
 ip nat outside
 no shutdown
!
interface Ethernet0/2
 no ip address
 no shutdown
!
interface Ethernet0/2.25
 encapsulation dot1q 25
 ip address 192.168.25.3 255.255.255.0 
 ip nat inside
 vrrp 25 ip 192.168.25.1
 vrrp 25 priority 95
 no shutdown
!
interface Ethernet0/2.30
 encapsulation dot1q 30
 ip address 192.168.30.3 255.255.255.0
 ip nat inside
 vrrp 30 ip 192.168.30.1
 vrrp 30 priority 95
 no shutdown
!
interface Tunnel2
 ip address 172.16.20.3 255.255.255.248
 ip nhrp authentication DMVPN
 ip nhrp map 172.16.20.1 190.0.1.1    
 ip nhrp map multicast 190.0.1.1      
 ip nhrp network-id 2
 ip nhrp nhs 172.16.20.1
 tunnel source 190.0.2.1
 tunnel mode gre multipoint
!
router eigrp 10
 router-id 6.6.6.6
 passive-interface ethernet0/2.30
 passive-interface ethernet0/2.25
 network 172.16.20.0 0.0.0.7
 network 192.168.25.0 0.0.0.255 
 network 192.168.30.0 0.0.0.255
 no auto-summary
!
ip route 0.0.0.0 0.0.0.0 10.0.0.77
!
ip access-list standard 10
 10 permit 192.168.25.0 0.0.0.255
 20 permit 192.168.30.0 0.0.0.255
!
ip nat pool BRANCH2-POOL 190.0.2.2 190.0.2.6 prefix-length 29
ip nat inside source list 10 pool BRANCH2-POOL overload
